Algoritmo AreatriangulO
Definir base, altura ,area  como real
Escribir "Ingrese base:"; Leer base
Escribir "Ingresa altura:"; Leer altura

area <- (base * altura) / 2
Escribir " Área  = ", area

	Definir numero1 Como Entero
	Escribir " Ingresar N:"; leer n
	
	Si numero1 % 2 = 0 Entonces
		Escribir "N es par"
	Sino 
		Escribir " N es impar"
	FinSi
FinAlgoritmo
	
